# =============================================================================
# GraphQL-контракт для Plant Management System
#
# Эта схема описывает все доступные запросы (Query), мутации (Mutation) и типы.
# Полностью соответствует функциональности REST API.
# =============================================================================

# Пользовательские скалярные типы
scalar DateTime
scalar Date

# ---------------------------------------------------------------------------
# Основные типы данных
# ---------------------------------------------------------------------------

# Шаблон растения (справочная информация)
type PlantSample {
    id: ID!
    type: String
    fruiting: String
    flower: String
    difficulty: Int
    wikiUrl: String!
    homePlants(page: Int = 0, size: Int = 20): HomePlantConnection!
    growthCharacteristic: GrowthCharacteristic
}

# Характеристики роста
type GrowthCharacteristic {
    id: ID!
    lx: Int!
    water: Int!
    heat: Int!
    air: Int!
    nitrogen: Int!
    soilPh: Float!
    recordedAt: DateTime!
    humidity: String
    plantSample: PlantSample
}

# Домашнее растение (экземпляр, принадлежащий пользователю)
type HomePlant {
    id: ID!
    name: String!
    note: String!
    species: String!
    age: Int!
    plantSample: PlantSample
    robots(page: Int = 0, size: Int = 20): RobotConnection!
    user: User
}

# Датчик
type Robot {
    id: ID!
    name: String!
    sensorType: Int!
    measuredCharacteristic: String!
    usedCharacteristic: String!
    homePlant: HomePlant!
}

# Пользователь
type User {
    id: ID!
    name: String!
    mail: String!
    phone: String!
    homePlant: HomePlant
}

# Постраничная коллекция домашних растений
type HomePlantConnection {
    content: [HomePlant!]!
    pageInfo: PageInfo!
    totalElements: Int!
}

# Постраничная коллекция шаблонов растений
type PlantSampleConnection {
    content: [PlantSample!]!
    pageInfo: PageInfo!
    totalElements: Int!
}

# Постраничная коллекция роботов
type RobotConnection {
    content: [Robot!]!
    pageInfo: PageInfo!
    totalElements: Int!
}

# Метаданные страницы
type PageInfo {
    pageNumber: Int!
    pageSize: Int!
    totalPages: Int!
    last: Boolean!
}

# Создание домашнего растения
input CreateHomePlantInput {
    name: String!
    note: String!
    species: String!
    age: Int!
    sampleId: ID
}

# Обновление домашнего растения
input UpdateHomePlantInput {
    name: String!
    note: String!
    species: String!
    age: Int!
}

# Создание шаблона растения
input CreatePlantSampleInput {
    type: String
    fruiting: String
    flower: String
    difficulty: Int
    wikiUrl: String!
}

# Обновление шаблона растения
input UpdatePlantSampleInput {
    type: String
    fruiting: String
    flower: String
    difficulty: Int
    wikiUrl: String!
}

# Создание робота
input CreateRobotInput {
    name: String!
    sensorType: Int!
    measuredCharacteristic: String!
    usedCharacteristic: String!
}

# Обновление робота
input UpdateRobotInput {
    name: String!
    sensorType: Int!
    measuredCharacteristic: String!
    usedCharacteristic: String!
}

# Создание характеристик роста
input CreateGrowthCharInput {
    lx: Int!
    water: Int!
    heat: Int!
    air: Int!
    nitrogen: Int!
    soilPh: Float!
    humidity: String
}

# Фильтр для шаблонов растений
input PlantSampleFilter {
    type: String
    difficulty: Int
    hasFlower: Boolean
}

type Query {
    homePlant(id: ID!): HomePlant
    homePlants(page: Int = 0, size: Int = 20): HomePlantConnection!

    plantSample(id: ID!): PlantSample
    plantSamples(filter: PlantSampleFilter, page: Int = 0, size: Int = 20): PlantSampleConnection!

    robot(id: ID!): Robot
    robotsByPlant(plantId: ID!, page: Int = 0, size: Int = 20): RobotConnection!

    growthCharacteristics(plantId: ID!): GrowthCharacteristic
}

type Mutation {
    createHomePlant(input: CreateHomePlantInput!): HomePlant!
    updateHomePlant(id: ID!, input: UpdateHomePlantInput!): HomePlant!
    deleteHomePlant(id: ID!): Boolean!
    linkHomePlantToSample(plantId: ID!, sampleId: ID!): HomePlant!
    submitGrowthReportFromPlant(plantId: ID!, input: CreateGrowthCharInput!): GrowthCharacteristic!

    createPlantSample(input: CreatePlantSampleInput!): PlantSample!
    updatePlantSample(id: ID!, input: UpdatePlantSampleInput!): PlantSample!
    deletePlantSample(id: ID!): Boolean!

    createRobot(plantId: ID!, input: CreateRobotInput!): Robot!
    updateRobot(plantId: ID!, robotId: ID!, input: UpdateRobotInput!): Robot!
    deleteRobot(robotId: ID!, plantId: ID!): Boolean!
    addRobotToPlant(plantId: ID!, robotId: ID!): GrowthCharacteristic!
    removeRobotFromPlant(robotId: ID!, plantId: ID!): Boolean!

    submitGrowthReportFromRobot(plantId: ID!, robotId: ID!, input: CreateGrowthCharInput!): GrowthCharacteristic!
    sendRecommendations(plantId: ID!, input: CreateGrowthCharInput!): Boolean!
}